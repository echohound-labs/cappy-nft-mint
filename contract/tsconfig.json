{
  "compilerOptions": {
    "types": "mocha",
    "allowJs": true,
    "esModuleInterop": true,
    "lib": ["es2020"],
    "module": "commonjs",
    "target": "es2020",
    "sourceMap": true,
    "strict": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["scripts/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
