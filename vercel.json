{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/metadata/:id",
      "destination": "/metadata/:id.json"
    },
    {
      "source": "/api/rpc",
      "destination": "/api/rpc.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}